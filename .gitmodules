[submodule "third_party/vst3sdk/base"]
	path = third_party/vst3sdk/base
	url = https://github.com/steinbergmedia/vst3_base.git
	shallow = true
[submodule "third_party/vst3sdk/pluginterfaces"]
	path = third_party/vst3sdk/pluginterfaces
	url = https://github.com/steinbergmedia/vst3_pluginterfaces.git
	shallow = true
[submodule "third_party/vst3sdk/public.sdk"]
	path = third_party/vst3sdk/public.sdk
	url = https://github.com/steinbergmedia/vst3_public_sdk.git
	shallow = true
